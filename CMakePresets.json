{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}/$env{CC}",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug with ASan and UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHAREDSTUFF_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Debug with TSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHAREDSTUFF_SANITIZER": "thread"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Optimized release with debug information",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SHAREDSTUFF_BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "multi",
      "inherits": "base",
      "displayName": "Ninja multi-config",
      "generator": "Ninja Multi-Config"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "multi-debug",
      "configurePreset": "multi",
      "configuration": "Debug"
    },
    {
      "name": "multi-relwithdebinfo",
      "configurePreset": "multi",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "lint",
      "configurePreset": "debug",
      "targets": ["sharedstuff_lint"]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan"
    },
    {
      "name": "multi-debug",
      "inherits": "base",
      "configurePreset": "multi",
      "configuration": "Debug"
    },
    {
      "name": "multi-relwithdebinfo",
      "inherits": "base",
      "configurePreset": "multi",
      "configuration": "RelWithDebInfo"
    }
  ],
  "workflowPresets": [
    {
      "name": "ci-debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "build", "name": "lint" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "ci-tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "ci-release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    },
    {
      "name": "ci-multi",
      "steps": [
        { "type": "configure", "name": "multi" },
        { "type": "build", "name": "multi-debug" },
        { "type": "test", "name": "multi-debug" },
        { "type": "build", "name": "multi-relwithdebinfo" },
        { "type": "test", "name": "multi-relwithdebinfo" }
      ]
    }
  ]
}
